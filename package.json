{
  "name": "aura-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true}); require('node:fs').rmSync('.test-build',{recursive:true,force:true}); require('node:fs').rmSync('server.js',{force:true});\"",
    "lint": "tsc --noEmit",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node -e \"require('node:fs').mkdirSync('.test-build',{recursive:true}); require('node:fs').writeFileSync('.test-build/package.json', JSON.stringify({ type: 'commonjs' }));\" && node --test --test-reporter=spec .test-build/tests/*.test.js .test-build/tests/**/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "dukascopy-node": "^1.49.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "googleapis": "^174.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.1.0",
    "lightweight-charts-drawing": "^0.1.1",
    "lightweight-charts-indicators": "^0.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "oakscriptjs": "^0.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "caniuse-lite": "^1.0.30001807",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Production-focused trading replay, backtesting, and journaling engine.",
  "engines": {
    "node": ">=22"
  }
}
