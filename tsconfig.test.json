{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": ".test-build",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022"
  },
  "include": [
    "src/lib/**/*.ts",
    "src/components/analytics/analyticsEngine.ts",
    "src/services/marketdata/**/*.ts",
    "tests/**/*.ts"
  ]
}
